    "express": "^5.3.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.28.2",
    "jquery": "^4.0.0",
    "lodash": "^4.18.1",
    "sass": "^1.107.1"
  },
